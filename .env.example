# Database connection string (SQLite used for local dev in this hackathon)
DATABASE_URL="file:./dev.db"

# OpenRouter API Key for AI Integration (Member 3)
OPENROUTER_API_KEY="your_openrouter_api_key_here"

# Optional: Specific model to use via OpenRouter
AI_MODEL="openai/gpt-4o-mini"

# Optional: URL of your deployed app (used by OpenRouter for analytics)
APP_URL="http://localhost:3000"
